# 로컬 복사: cp .env.local.example .env.local  후 값 채우기 (이 파일에는 비밀이 없도록 비워 두세요.)

## Firebase (클라이언트 — Google 로그인·Firestore 등). 값은 .env.local에만 넣고 Git에는 커밋하지 마세요.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

## Google 로그인 토글(기본 true). 끄려면 false
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=true
## 위와 동일 목적의 예비 이름(둘 중 하나만 있으면 됨)
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=

## 베타 신청(/join) → Google Apps Script 웹 앱(Web app) 실행 URL (선택)
## docs/beta-signup-google-sheet.md 참고 · 실제 URL은 여기 플레이스홀더만 두고 .env.local에만 넣을 것.
NEXT_PUBLIC_BETA_SIGNUP_ENDPOINT=

## 베타 승인 조회(서버 전용). 실제 URL·비밀값은 .env.local에만 두고 Git에 커밋하지 마세요.
BETA_ACCESS_ENDPOINT=
BETA_ACCESS_SECRET=

## 베타 신청 Firestore + /internal/beta-approval (서비스 계정 JSON은 Git에 넣지 말 것)
# ADMIN_EMAILS=owner@example.com
# FIREBASE_SERVICE_ACCOUNT_JSON=
